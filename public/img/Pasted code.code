import 'package:flutter/material.dart';
import 'package:image_picker/image_picker.dart';

class AddLeaveDialog extends StatefulWidget {
  final int initialDay;

  const AddLeaveDialog({super.key, required this.initialDay});

  @override
  State<AddLeaveDialog> createState() => _AddLeaveDialogState();
}

class _AddLeaveDialogState extends State<AddLeaveDialog> {
  final _formKey = GlobalKey<FormState>();

  String? selectedLeaveType;
  int leaveDuration = 0;

  DateTime? startDate;
  DateTime? endDate;

  late TextEditingController startDateController;
  late TextEditingController endDateController;
  late TextEditingController reasonController;

  XFile? medicalFile;
  final ImagePicker _picker = ImagePicker();

  @override
  void initState() {
    super.initState();

    final now = DateTime.now();
    startDate = DateTime(now.year, now.month, widget.initialDay);
    endDate = startDate;

    startDateController = TextEditingController(
      text: "${startDate!.day}/${startDate!.month}/${startDate!.year}",
    );

    endDateController = TextEditingController(
      text: "${endDate!.day}/${endDate!.month}/${endDate!.year}",
    );

    reasonController = TextEditingController();
  }

  @override
  void dispose() {
    startDateController.dispose();
    endDateController.dispose();
    reasonController.dispose();
    super.dispose();
  }

  Future<void> _pickDate(bool isStart) async {
    final picked = await showDatePicker(
      context: context,
      initialDate: startDate ?? DateTime.now(),
      firstDate: DateTime(2024),
      lastDate: DateTime(2030),
    );

    if (picked != null) {
      setState(() {
        if (isStart) {
          startDate = picked;
          startDateController.text =
              "${picked.day}/${picked.month}/${picked.year}";
        } else {
          endDate = picked;
          endDateController.text =
              "${picked.day}/${picked.month}/${picked.year}";
        }
      });
    }
  }

  Future<void> _pickMedicalFile() async {
    final file = await _picker.pickImage(source: ImageSource.gallery);
    if (file != null) {
      setState(() => medicalFile = file);
    }
  }

  @override
  Widget build(BuildContext context) {
    return Dialog(
      backgroundColor: Color(0xFFFFFFFF),
      shape: RoundedRectangleBorder(borderRadius: BorderRadius.circular(14)),
      child: SizedBox(
        width: 460,
        child: Padding(
          padding: const EdgeInsets.all(16),
          child: Form(
            key: _formKey,
            child: Column(
              mainAxisSize: MainAxisSize.min,
              crossAxisAlignment: CrossAxisAlignment.start,
              children: [
                const Center(
                  child: Text(
                    "Add New Leave",
                    style: TextStyle(
                      fontSize: 18,
                      fontWeight: FontWeight.bold,
                      color: Color(0xFF003366),
                    ),
                  ),
                ),

                const Divider(height: 20),

                /// Leave Type

                /// LEAVE TYPE
                const Text(
                  "Type",
                  style: TextStyle(fontSize: 16, fontWeight: FontWeight.w500),
                ),
                const SizedBox(height: 4),
                DropdownButtonFormField<String>(
                  value: selectedLeaveType,
                  hint: const Text(
                    "Select Leave Type",
                    style: TextStyle(
                      fontSize: 16,
                      fontWeight: FontWeight.w500,
                      color: Colors.black,
                    ),
                  ),
                  style: const TextStyle(
                    fontSize: 16,
                    fontWeight: FontWeight.w500,
                    color: Colors.black,
                  ),

                  decoration: InputDecoration(
                    isDense: true,

                    // 🔹 Default (inactive) border
                    enabledBorder: const OutlineInputBorder(
                      borderSide: BorderSide(color: Colors.grey, width: 1),
                    ),

                    // 🔹 Active (on click / focus) border
                    focusedBorder: const OutlineInputBorder(
                      borderSide: BorderSide(
                        color: Color(0xFF003366),
                        width: 2,
                      ),
                    ),

                    // 🔹 Error border (optional)
                    errorBorder: const OutlineInputBorder(
                      borderSide: BorderSide(color: Colors.red, width: 1),
                    ),

                    border: const OutlineInputBorder(), // fallback
                  ),

                  dropdownColor: Color(0xFFFFFFFF),
                  items: const [
                    DropdownMenuItem(value: "Sick", child: Text("Sick Leave")),
                    DropdownMenuItem(
                      value: "Casual",
                      child: Text("Casual Leave"),
                    ),
                    DropdownMenuItem(
                      value: "LWP",
                      child: Text("Leave Without Pay"),
                    ),
                  ],
                  onChanged: (v) => setState(() => selectedLeaveType = v),
                ),

                const SizedBox(height: 10),

                /// LEAVE DURATION
                const Text(
                  "Leave Duration",
                  style: TextStyle(fontSize: 16, fontWeight: FontWeight.w500),
                ),
                Column(
                  children: [
                    _radio("Full Day", 0),
                    _radio("First Half", 1),
                    _radio("Second Half", 2),
                  ],
                ),

                const SizedBox(height: 10),

                /// Start Date
                const Text("Start Date"),
                const SizedBox(height: 4),
                _dateField(startDateController, () => _pickDate(true)),

                const SizedBox(height: 10),

                /// End Date
                const Text("End Date"),
                const SizedBox(height: 4),
                _dateField(endDateController, () => _pickDate(false)),

                const SizedBox(height: 10),

                /// Medical Document
                 const Text(
                "Medical Document (Max size: 512 KB)",
                style: TextStyle(fontSize: 16, fontWeight: FontWeight.w500),
              ),
                const SizedBox(height: 4),
                OutlinedButton.icon(
                onPressed: _pickMedicalFile,
                icon: const Icon(
                  Icons.attach_file,
                  size: 18,
                  color: Color(0xFF003366),
                ),
                label: Text(
                  medicalFile == null ? "Choose File" : medicalFile!.name,
                  style: const TextStyle(
                    fontSize: 16,
                    fontWeight: FontWeight.w500,
                    color: Color(0xFF003366),
                  ),
                ),
              ),
                const SizedBox(height: 10),

                /// Reason
                const Text(
                  "Reason",
                  style: TextStyle(fontSize: 16, fontWeight: FontWeight.w500),
                ),
                const SizedBox(height: 4),
                TextFormField(
                  controller: reasonController,
                  maxLines: 2,
                  decoration: InputDecoration(
                    isDense: true,

                    // 🔹 Default (inactive) border
                    enabledBorder: OutlineInputBorder(
                      borderSide: BorderSide(
                        color: Colors.grey, // 👈 default color
                        width: 1,
                      ),
                    ),

                    // 🔹 Active (on click / focus) border
                    focusedBorder: OutlineInputBorder(
                      borderSide: BorderSide(
                        color: Color(0xFF003366), // 👈 active color
                        width: 2,
                      ),
                    ),

                    // 🔹 Optional: error state
                    errorBorder: OutlineInputBorder(
                      borderSide: BorderSide(color: Colors.red, width: 1),
                    ),

                    border: OutlineInputBorder(), // fallback
                  ),
                  validator: (value) {
                    if (value == null || value.isEmpty) {
                      return "Please enter reason";
                    }
                    return null;
                  },
                ),

                const SizedBox(height: 16),

                /// Buttons
                Row(
                  mainAxisAlignment: MainAxisAlignment.end,
                  children: [
                    TextButton(
                      onPressed: () => Navigator.pop(context),
                      child: const Text(
                        "Cancel",
                        style: TextStyle(color: Color(0XFF003366)),
                      ),
                    ),
                    const SizedBox(width: 8),
                    ElevatedButton(
                      style: ElevatedButton.styleFrom(
                        backgroundColor: const Color(0xFF003366),
                        padding: const EdgeInsets.symmetric(
                          horizontal: 18,
                          vertical: 10,
                        ),
                      ),
                      onPressed: () => Navigator.pop(context),
                      child: const Text(
                        "Submit",
                        style: TextStyle(
                          backgroundColor: Color(0xFF003366),
                          color: Color(0xFFFFFFFF),
                        ),
                      ),
                    ),
                  ],
                ),
              ],
            ),
          ),
        ),
      ),
    );
  }

  Widget _radio(String text, int value) {
    return InkWell(
      onTap: () => setState(() => leaveDuration = value),
      child: Padding(
        padding: const EdgeInsets.symmetric(vertical: 2), // 👈 very small gap
        child: Row(
          children: [
            Radio<int>(
              activeColor: const Color(0xFF003366), // 👈 selected circle color
              value: value,
              groupValue: leaveDuration,
              visualDensity: VisualDensity.compact,
              materialTapTargetSize: MaterialTapTargetSize.shrinkWrap,
              onChanged: (v) => setState(() => leaveDuration = v!),
            ),
            const SizedBox(width: 4),
            Text(
              text,
              style: const TextStyle(fontSize: 13, fontWeight: FontWeight.w500),
            ),
          ],
        ),
      ),
    );
  }

  Widget _dateField(TextEditingController controller, VoidCallback onTap) {
    return TextFormField(
      controller: controller,
      readOnly: true,
      onTap: onTap,
      decoration: const InputDecoration(
        isDense: true,
        suffixIcon: Icon(
          Icons.calendar_today,
          size: 18,
          color: Color(0xFF003366),
        ),

        // 🔹 Default (inactive) border
        enabledBorder: OutlineInputBorder(
          borderSide: BorderSide(color: Colors.grey, width: 1),
        ),

        // 🔹 Active (on click / focus) border
        focusedBorder: OutlineInputBorder(
          borderSide: BorderSide(color: Color(0xFF003366), width: 2),
        ),

        // 🔹 Error border (optional)
        errorBorder: OutlineInputBorder(
          borderSide: BorderSide(color: Colors.red, width: 1),
        ),

        border: OutlineInputBorder(), // fallback
      ),
      validator: (value) =>
          value == null || value.isEmpty ? "Please select date" : null,
    );
  }
}
